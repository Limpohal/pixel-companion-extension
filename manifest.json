{
  "manifest_version": 3,
  "name": "Pixel Companion",
  "version": "1.0.0",
  "description": "A chunky pixel pal that walks your browser, jumps, rides the scrollbar and talks - twelve characters, each with its own personality.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pixel Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/art.js",
        "content/character.js",
        "content/synth.js",
        "content/speech.js",
        "content/behaviors.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}